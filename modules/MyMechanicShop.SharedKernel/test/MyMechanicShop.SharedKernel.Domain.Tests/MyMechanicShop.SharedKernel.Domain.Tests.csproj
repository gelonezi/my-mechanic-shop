<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>MyMechanicShop.SharedKernel</RootNamespace>
  </PropertyGroup>

  <!-- Pure unit tests: the kernel's value objects and enums have no DI, repositories or
       database, so no Volo.Abp.TestBase / Autofac / NSubstitute (unlike Catalog's TestBase). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyMechanicShop.SharedKernel.Domain\MyMechanicShop.SharedKernel.Domain.csproj" />
  </ItemGroup>

</Project>
