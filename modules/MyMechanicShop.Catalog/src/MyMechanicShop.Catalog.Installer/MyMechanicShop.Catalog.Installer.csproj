<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props"/>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <RootNamespace>MyMechanicShop.Catalog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.VirtualFileSystem" Version="10.6.0"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="..\..\MyMechanicShop.Catalog.abpmdl"/>
    <Content Include="..\..\MyMechanicShop.Catalog.abpmdl">
      <Pack>true</Pack>
      <PackagePath>content\</PackagePath>
      <Visible>false</Visible>
    </Content>
    <None Remove="..\..\**\*.abppkg*" />
    <Content Include="..\..\**\*.abppkg*">
      <Pack>true</Pack>
      <PackagePath>content\</PackagePath>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>