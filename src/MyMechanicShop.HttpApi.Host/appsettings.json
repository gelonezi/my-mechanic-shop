{
  "App": {
    "SelfUrl": "https://localhost:44390",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.MyMechanicShop.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../MyMechanicShop.db;",
    "Catalog": "Data Source=../../MyMechanicShopCatalog.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44390",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "MyMechanicShop_Swagger",
    "CertificatePassPhrase": "ccf70ee2-d3bb-447c-98bf-3c07a3ffec89"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "aKlBpItrAnSmWFXq"
  }
}