# Single source of truth for the entire repository
root = true

# ─────────────────────────────── C# ───────────────────────────────
[*.cs]
indent_style = space
indent_size = 4

# ─────────────────────────────── ReSharper ───────────────────────────────
resharper_place_type_attribute_on_same_line = never
resharper_place_method_attribute_on_same_line = never
resharper_place_accessorholder_attribute_on_same_line = never
resharper_place_accessor_attribute_on_same_line = never
resharper_place_field_attribute_on_same_line = never
resharper_place_record_field_attribute_on_same_line = never

# ──────────────────────── MSBuild / XML config ────────────────────
[*.{csproj,props,targets,config,xml}]
indent_style = space
indent_size = 2

# ──────────────────────────── Solution ────────────────────────────
[*.slnx]
indent_style = space
indent_size = 4
resharper_xml_wrap_tags_and_pi = false
resharper_xml_wrap_text = false
resharper_xml_attribute_style = do_not_touch

# ───────────────────────── Angular workspaces ─────────────────────
[angular/**]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[angular/**.ts]
quote_type = single

[modules/*/angular/**]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[modules/*/angular/**.ts]
quote_type = single

# ──────────────────────────── Markdown ────────────────────────────
[*.md]
max_line_length = off
trim_trailing_whitespace = false
